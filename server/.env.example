DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# Fill in after `cloudflared tunnel login` + `cloudflared tunnel create copilot`
TUNNEL_TOKEN=

# Primary suggestion path (Phase 3, v4): Groq free tier, OpenAI-compatible
# API. Get a free key at https://console.groq.com/keys. ai/cloud_router.py
# tries this first, falls back to the local model below on any
# connection/timeout/rate-limit/empty-response failure, or immediately if
# this is left blank.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset — override to try a different
# Groq-hosted model.
GROQ_MODEL=

# Other cloud providers (Phase 7 note — leave blank until/unless Groq's
# free tier limits become a real problem)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Phase 1: audio pipeline ------------------------------------------
# faster-whisper model size. tiny/base/small/medium/large-v3 — benchmark
# on your actual server hardware per the build plan's Phase 2 note; small
# is a reasonable starting guess, not a measured choice.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# VAD speech probability threshold (0-1) and how much trailing silence
# (ms) closes out a segment as "finished speaking".
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=600
# Segments shorter than this (ms) are discarded as VAD blips, not real turns.
MIN_SEGMENT_MS=250
# How often (ms) to emit a partial transcript while still speaking.
PARTIAL_INTERVAL_MS=1200

# Naive speaker labeler: silence gap (seconds) that triggers an A/B flip.
# Only used when ENABLE_DIARIZATION=0 (the default).
SPEAKER_FLIP_GAP_SECONDS=0.7

# Real diarization via pyannote.audio (opt-in — see requirements.txt).
# Requires accepting pyannote/speaker-diarization-3.1's terms on
# huggingface.co and generating a read token.
ENABLE_DIARIZATION=0
HF_TOKEN=

# --- Phase 3: local LLM suggestions ------------------------------------
# Required: path to a GGUF model file, as seen INSIDE THE CONTAINER.
# docker-compose.yml already bind-mounts ./server:/app, so the easiest
# path: drop the .gguf file anywhere under server/ (e.g. server/models/),
# then point this at its /app/... path — no docker-compose.yml changes
# needed, no extra download/bake step. Suggestions are silently skipped
# (logged, not fatal) until this is set to a real, existing file.
# Which model SIZE to start with is an open decision that depends on your
# server's actual RAM/GPU — see the build plan. A 7-8B Q4_K_M quantized
# instruct model is a reasonable first benchmark on CPU-only hardware.
LLM_MODEL_PATH=
LLM_N_CTX=4096
# 0 = CPU only. See requirements.txt for the GPU-offload rebuild flags.
LLM_N_GPU_LAYERS=0
# Leave unset to default to os.cpu_count().
LLM_N_THREADS=
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.4
# How many recent turns of conversation to include as context when
# generating a suggestion for a detected question.
SUGGESTION_CONTEXT_TURNS=6
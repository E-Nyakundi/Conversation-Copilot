DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# Fill in after `cloudflared tunnel login` + `cloudflared tunnel create copilot`
TUNNEL_TOKEN=

# Primary suggestion path (Phase 3, v4): Groq free tier, OpenAI-compatible
# API. Get a free key at https://console.groq.com/keys. ai/cloud_router.py
# tries this first, falls back to the local model below on any
# connection/timeout/rate-limit/empty-response failure, or immediately if
# this is left blank.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset — override to try a different
# Groq-hosted model.
GROQ_MODEL=

# Phase 2 (2026-08-16) — extraction mode: "rule_based" (default) or "llm".
# rule_based = conversation/intent.py's regex extractor: zero latency, no
# deps, no network needed, tested across every real session so far.
# llm = conversation/llm_extract.py: a real Groq call per finalized turn
# for actual semantic understanding — catches questions/decisions/etc.
# with no matching lexical pattern (e.g. "the capital of Minnesota,
# right?" with no "?" as a real question elsewhere in a sentence). Real
# trade-offs, not a strict upgrade — see that module's docstring: added
# per-turn latency/cost, and a different failure mode (can hallucinate
# items, not just miss them) that hasn't been measured against the
# rule-based baseline yet. Falls back to rule_based per-turn on any llm
# failure rather than losing extraction outright.
# "hybrid" (2026-08-16, build plan §11a): runs rule_based first (same
# zero-cost path as always) and only calls the LLM extractor on turns
# where rule_based found nothing — cheaper than "llm" on every turn, and
# catches missing-keyword-shaped gaps (e.g. the "discuss"/"cover" bug
# this was added after) without needing to keep hand-maintaining a verb
# list. Also opt-in, not yet the default — see consumers.py's docstring
# for the full trade-off (it can't tell "correctly found nothing" from
# "missed something", so it pays the LLM call on genuine-zero turns too).
EXTRACTION_MODE=rule_based
# Defaults to GROQ_MODEL above if unset — override to use a different/
# cheaper/faster model specifically for extraction vs. suggestions.
EXTRACTION_GROQ_MODEL=

# stt/cloud_router.py — same GROQ_API_KEY above is reused for Whisper
# transcription (the only STT call in the pipeline — see that module's
# docstring). Set to "local" to force the local faster-whisper engine
# even with a Groq key present. Any other value falls back to local
# with a warning.
STT_PROVIDER=groq
# Defaults to whisper-large-v3-turbo if unset.
GROQ_WHISPER_MODEL=

# Other cloud providers (Phase 7 note — leave blank until/unless Groq's
# free tier limits become a real problem)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Phase 1: audio pipeline ------------------------------------------
# faster-whisper model size. tiny/base/small/medium/large-v3 — benchmark
# on your actual server hardware; small is a reasonable starting guess,
# not a measured choice. Bigger = more accurate, more RAM, slower per
# segment — medium is the next step up if small's accuracy isn't enough.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Beam search width — higher explores more candidate transcriptions per
# segment before picking one, generally more accurate, linearly slower.
# 1 = greedy decoding (fastest, least accurate). 5 is a reasonable
# starting point for accuracy testing; drop toward 1 only if latency
# becomes the bottleneck instead.
# Free accuracy nudge — biases Whisper toward expected vocabulary/spelling,
# no RAM/latency cost (unlike WHISPER_MODEL_SIZE/WHISPER_BEAM_SIZE). Not a
# dialect selector — language=en above already covers accents on its own.
# Example, tune to what your conversations are actually about:
# WHISPER_INITIAL_PROMPT=Technical conversation about software engineering — Docker, Kubernetes, databases, N+1 queries.
# 2026-08-16 (build plan §11a): a real prod session mistranscribed
# "one-on-one" as "Wonder One" mid coding-interview-practice — this kind
# of domain-vocabulary miss is exactly what this knob is for. Interview-
# practice-flavored starting point, tune further against your own
# sessions' actual misses:
# WHISPER_INITIAL_PROMPT=Software engineering interview: system design, distributed systems, rate limiter, one-on-one, CRDT, sharding, dead-letter queue, race condition.
WHISPER_INITIAL_PROMPT=

# VAD speech probability threshold (0-1) and how much trailing silence
# (ms) closes out a segment as "finished speaking".
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=600
# Segments shorter than this (ms) are discarded as VAD blips, not real turns.
MIN_SEGMENT_MS=250
# Max raw audio (ms) allowed to buffer on one connection before the oldest
# excess is dropped to resync to real time — see AudioStreamConsumer's
# _handle_audio_chunk docstring for why. Bounds worst-case latency if
# processing ever falls behind the incoming audio rate.
BACKPRESSURE_MAX_BACKLOG_MS=2000

# Naive speaker labeler: silence gap (seconds) that triggers an A/B flip.
# Only used when diarization_mode() resolves to "naive" — see below.
SPEAKER_FLIP_GAP_SECONDS=0.7

# Diarization mode. Leave unset (or set SPEAKER_DIARIZATION_MODE=embedding
# explicitly) to get real cross-turn speaker identity via
# SessionSpeakerRegistry + PyannoteEmbedder — supports more than 2
# speakers, up to SPEAKER_MAX_COUNT (default 6). Requires accepting
# pyannote/speaker-diarization-3.1's terms on huggingface.co and
# generating a read token below.
#
# ENABLE_DIARIZATION=0 is the OLD flag, kept only for backward
# compatibility — if set, it always wins over the new default and forces
# pure pause-based "naive" labeling (2 speakers, gap-flip only, no real
# voice differentiation) regardless of what's deployed. This is exactly
# what silently happened on the VM 2026-08-14: the embedding code was
# live, but the real .env.production still had ENABLE_DIARIZATION=0
# from before that work, so it never actually ran. Leave commented out
# unless deliberately forcing the old naive behavior back.
# ENABLE_DIARIZATION=0
SPEAKER_DIARIZATION_MODE=embedding
HF_TOKEN=

# --- Phase 3: local LLM suggestions ------------------------------------
# Required: path to a GGUF model file, as seen INSIDE THE CONTAINER.
# docker-compose.yml already bind-mounts ./server:/app, so the easiest
# path: drop the .gguf file anywhere under server/ (e.g. server/models/),
# then point this at its /app/... path — no docker-compose.yml changes
# needed, no extra download/bake step. Suggestions are silently skipped
# (logged, not fatal) until this is set to a real, existing file.
#
# Which model SIZE to start with is still an open decision (build plan
# Phase 3 go/no-go) — this VM has no GPU (2 vCPU AMD EPYC, see build
# plan §6a), which changes the calculus from the old "7-8B Q4_K_M"
# guidance here: on CPU-only hardware, model size dominates speed far
# more than quality per size once you're past ~4B. Reasonable 2026
# CPU-only starting candidates, Q4_K_M GGUF, roughly ranked by expected
# quality/speed balance on this hardware (verified current as of
# 2026-08-15, not from memory — check yourself before committing, this
# moves fast): Phi-4-mini (3.8B, strongest quality-per-size at this
# tier), Llama 3.2 3B (lighter/faster, well-trodden), SmolLM3 3B or
# Qwen3.5 4B as a third comparison point. Download 2-3 of these and run
# `python manage.py benchmark_local_llm --model a=/path/to/one.gguf
# --model b=/path/to/other.gguf` (added 2026-08-15) to compare latency
# and output side by side on this actual VM before picking one.
LLM_MODEL_PATH=
LLM_N_CTX=4096
# 0 = CPU only. See requirements.txt for the GPU-offload rebuild flags.
LLM_N_GPU_LAYERS=0
# Leave unset to default to os.cpu_count().
LLM_N_THREADS=
# Superseded by Phase 4's per-level budgets below (ai/prompts.py:
# ANSWER_LEVELS) — no longer read directly, kept here only so an old
# .env with this set doesn't silently do nothing unnoticed.
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.4
# How many recent turns of conversation to include as context when
# generating a suggestion for a detected question.
SUGGESTION_CONTEXT_TURNS=6
# Wider window used instead of SUGGESTION_CONTEXT_TURNS when the
# detected question was an imperative-ask match (intent.py's imperative
# verb pattern — "write a function that...", "tell me about a time
# you..."). These are routinely set up across several prior turns
# (constraints, background) before the imperative sentence itself, so
# they need more context than an ordinary question does. See
# consumers.py._generate_suggestion.
SUGGESTION_CONTEXT_TURNS_IMPERATIVE=12
# Turns with fewer than this many words are dropped from that context
# before it's sent to the model — stray one-word turns (e.g. "August.")
# can otherwise get latched onto as the answer to an unrelated question.
CONTEXT_MIN_WORDS=3

# --- Phase 4: answer-level token budgets -------------------------------
# Optional per-level overrides of ai/prompts.py:ANSWER_LEVELS' hardcoded
# max_tokens (60/150/350). Leave unset to use those defaults — only set
# these once real usage shows they're wrong for your model/hardware.
# LLM_MAX_TOKENS_QUICK=60
# LLM_MAX_TOKENS_MEDIUM=150
# LLM_MAX_TOKENS_DETAILED=350
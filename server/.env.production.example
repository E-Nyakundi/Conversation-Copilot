DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=0
# Must include the sslip.io host Caddy is proxying (see
# infra/caddy-copilot.snippet) — swap to a real domain here too if one
# gets added later, alongside the Caddyfile change.
DJANGO_ALLOWED_HOSTS=145-241-102-99.sslip.io,localhost,127.0.0.1

# --- Phase 1: audio pipeline (same as dev — see server/.env.example for
# full comments on each) -------------------------------------------------
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Was hardcoded to 1 (greedy) before — now tunable. Bump this VM's value
# if accuracy testing shows small+beam_size=1 isn't good enough; see
# server/.env.example for the full trade-off explanation.
WHISPER_BEAM_SIZE=5
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=600
MIN_SEGMENT_MS=250
PARTIAL_INTERVAL_MS=1200
SPEAKER_FLIP_GAP_SECONDS=0.7
ENABLE_DIARIZATION=0
HF_TOKEN=

# --- Phase 3: hybrid LLM router (v4) -------------------------------------
# Local fallback: sized for the VM's actual 5.8GB RAM / 2 vCPU ceiling —
# do NOT use a 7-8B model here, it won't fit alongside Django/Redis/
# Whisper running concurrently. A 3B-class Q4_K_M GGUF is the target.
# Drop the .gguf file under server/models/ and point this at its
# /app/... path inside the container.
LLM_MODEL_PATH=
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=0
LLM_N_THREADS=
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.4
SUGGESTION_CONTEXT_TURNS=6

# Primary path: Groq free tier (OpenAI-compatible API). Get a free key
# at https://console.groq.com/keys. ai/cloud_router.py uses this first,
# falls back to the local model above on network failure, timeout, rate
# limit, or an empty response.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=

# Leave blank until/unless Groq's free tier limits become a real problem
# and a second provider is worth adding (see build plan Phase 7 note).
OPENROUTER_API_KEY=
GEMINI_API_KEY=

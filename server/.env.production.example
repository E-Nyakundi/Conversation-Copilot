DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=0
# Must include the sslip.io host Caddy is proxying (see
# infra/caddy-copilot.snippet) — swap to a real domain here too if one
# gets added later, alongside the Caddyfile change.
DJANGO_ALLOWED_HOSTS=145-241-102-99.sslip.io,localhost,127.0.0.1

# --- Phase 1: audio pipeline (same as dev — see server/.env.example for
# full comments on each) -------------------------------------------------
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Was hardcoded to 1 (greedy) before — now tunable. Bump this VM's value
# if accuracy testing shows small+beam_size=1 isn't good enough; see
# server/.env.example for the full trade-off explanation.
WHISPER_BEAM_SIZE=5
# Free accuracy nudge, no RAM/latency cost — see server/.env.example for
# the full explanation. Tune to what this deployment's conversations are
# actually about:
WHISPER_INITIAL_PROMPT=
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=600
MIN_SEGMENT_MS=250
# See server/.env.example for the full explanation — bounds worst-case
# latency by dropping the oldest buffered audio if a connection's
# processing ever falls behind the incoming rate.
BACKPRESSURE_MAX_BACKLOG_MS=2000
SPEAKER_FLIP_GAP_SECONDS=0.7
# Diarization mode. Leave unset to get the new default ("embedding" —
# SessionSpeakerRegistry + PyannoteEmbedder, real cross-turn speaker
# identity, more than 2 speakers supported up to SPEAKER_MAX_COUNT).
# ENABLE_DIARIZATION=0 below is the OLD flag and, if set, always wins
# over the new default per diarization_mode()'s own precedence rules —
# it forces pure pause-based "naive" labeling (2 speakers, gap-flip
# only) even though the embedding code is deployed. This bit Ed
# 2026-08-14: the VM's real .env.production still had this old line
# from before the diarization work, so the new code was live but never
# actually running — pause-based was the whole time despite the deploy.
# Commented out here so a fresh setup gets the new "embedding" default;
# uncomment only to deliberately force the old naive behavior back.
# ENABLE_DIARIZATION=0
SPEAKER_DIARIZATION_MODE=embedding
HF_TOKEN=

# --- Phase 3: hybrid LLM router (v4) -------------------------------------
# Local fallback: sized for the VM's actual 5.8GB RAM / 2 vCPU ceiling —
# do NOT use a 7-8B model here, it won't fit alongside Django/Redis/
# Whisper running concurrently. A 3B-class Q4_K_M GGUF is the target.
# Drop the .gguf file under server/models/ and point this at its
# /app/... path inside the container.
LLM_MODEL_PATH=
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=0
LLM_N_THREADS=
# Superseded by Phase 4's per-level budgets below — no longer read
# directly, kept here so an old .env.production with this set doesn't
# silently do nothing unnoticed.
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.4
SUGGESTION_CONTEXT_TURNS=6
SUGGESTION_CONTEXT_TURNS_IMPERATIVE=12
CONTEXT_MIN_WORDS=3
# Phase 4: optional per-level overrides — see .env.example for details.
# LLM_MAX_TOKENS_QUICK=60
# LLM_MAX_TOKENS_MEDIUM=150
# LLM_MAX_TOKENS_DETAILED=350

# Primary path: Groq free tier (OpenAI-compatible API). Get a free key
# at https://console.groq.com/keys. ai/cloud_router.py uses this first,
# falls back to the local model above on network failure, timeout, rate
# limit, or an empty response.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=

# stt/cloud_router.py — reuses GROQ_API_KEY above for Whisper
# transcription (the only STT call in the pipeline — see that module's
# docstring). Set to "local" to force local Whisper.
STT_PROVIDER=groq
# Defaults to whisper-large-v3-turbo if unset.
GROQ_WHISPER_MODEL=

# Leave blank until/unless Groq's free tier limits become a real problem
# and a second provider is worth adding (see build plan Phase 7 note).
OPENROUTER_API_KEY=
GEMINI_API_KEY=

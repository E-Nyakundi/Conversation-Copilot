<?xml version="1.0" encoding="utf-8"?>
<!-- Branding update (2026-08-31): was @android:color/white, matching
     Flutter's default project template. Changed to solid black plus
     the centered Conversation Copilot logo so the launch splash
     matches both the app's own dark "instrument panel" theme
     (theme.dart's CopilotColors.ink) and the brand icon itself,
     instead of flashing white before the Flutter engine draws its
     first, dark frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Branding update (2026-08-31): same reasoning as the plain
     drawable/launch_background.xml variant (for pre-API-21 devices):
     explicit solid black plus the centered logo, instead of the
     default's colorBackground reference, so both the v21+ and legacy
     splash paths render identically and match the brand. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
